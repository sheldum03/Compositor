<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../../Compositor/Resources/Fonts/SourceHanSansSC-Regular.otf" Link="Fonts/SourceHanSansSC-Regular.otf" />
    <None Include="../../../Compositor/Resources/Licenses/SourceHanSans-OFL.txt" Link="Licenses/SourceHanSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../dotnet-bridge/Native.cs" Link="Native.cs" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
  </ItemGroup>
</Project>
